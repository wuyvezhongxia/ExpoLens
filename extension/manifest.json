{
  "manifest_version": 3,
  "name": "ExpoLens · Response Analyzer",
  "version": "0.3.0",
  "description": "在独立窗口中连接 Expo / React Native Network，点击请求即可本地分析 Response。",
  "permissions": ["storage"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "http://[::1]/*",
    "ws://127.0.0.1/*",
    "ws://localhost/*",
    "ws://[::1]/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "打开 ExpoLens 分析器",
    "default_icon": {
      "48": "icon.png"
    }
  },
  "icons": {
    "48": "icon.png",
    "128": "icon.png"
  }
}
